generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// ── Enums ──────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  ANALYST
  DROPSHIPPER
  GUEST
}

enum Currency {
  COP
  USD
}

enum AssetType {
  IMAGE
  VIDEO
  DOCUMENT
  CERTIFICATE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  PAUSED
  DISCONTINUED
}

enum PlaybookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TemplateType {
  EMAIL
  SOCIAL
  LANDING
  AD
  WHATSAPP
}

enum BusinessModel {
  DROPSHIPPING
  MAQUILA
  HIBRIDO
}

enum OrderType {
  DROPSHIPPING_INMEDIATO
  DROPSHIPPING_PROGRAMADO
  MAQUILA_PRODUCCION
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  EN_PRODUCCION
  ENVIADO
  ENTREGADO
  CANCELADO
  DEVUELTO
}

enum Platform {
  EFFI
  DROPI
  HOKO
  MASTERSHOP
  SHOPIFY
  OTRO
}

// ── CRM Enums ────────────────────────────────────────────

enum CrmContactType {
  PERSONA
  EMPRESA
}

enum CrmContactSource {
  MANUAL
  IMPORTACION
  WEB
  REFERIDO
  WHATSAPP
  EMAIL
  OTRO
}

enum CrmPipelineType {
  LEADS
  DEALS
}

enum CrmActivityType {
  NOTA
  LLAMADA
  EMAIL
  WHATSAPP
  REUNION
  TAREA
}

enum CrmCampaignStatus {
  BORRADOR
  PROGRAMADA
  ENVIANDO
  COMPLETADA
  CANCELADA
}

enum CrmEmailStatus {
  PENDIENTE
  ENVIADO
  ENTREGADO
  ABIERTO
  CLICK
  REBOTADO
  FALLIDO
}

enum CrmWhatsAppStatus {
  PENDIENTE
  ENVIADO
  ENTREGADO
  LEIDO
  FALLIDO
}

enum CrmWhatsAppDirection {
  ENTRANTE
  SALIENTE
}

enum CrmAutomationTrigger {
  LEAD_CREADO
  LEAD_ETAPA_CAMBIADA
  DEAL_CREADO
  DEAL_ETAPA_CAMBIADA
  DEAL_GANADO
  DEAL_PERDIDO
  CONTACTO_CREADO
  ACTIVIDAD_CREADA
}

enum CrmAutomationAction {
  ENVIAR_EMAIL
  ENVIAR_WHATSAPP
  CREAR_ACTIVIDAD
  MOVER_ETAPA
  ASIGNAR_USUARIO
  NOTIFICAR
}

// ── Auth Models ────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          Role      @default(GUEST)
  image         String?
  emailVerified DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  collections  Collection[]
  auditLogs    AuditLog[]
  distributors Distributor[]

  // CRM relations
  crmAssignedContacts  CrmContact[]        @relation("CrmContactAssignee")
  crmCreatedContacts   CrmContact[]        @relation("CrmContactCreator")
  crmAssignedLeads     CrmLead[]           @relation("CrmLeadAssignee")
  crmAssignedDeals     CrmDeal[]           @relation("CrmDealAssignee")
  crmActivities        CrmActivity[]       @relation("CrmActivityCreator")
  crmCampaigns         CrmEmailCampaign[]  @relation("CrmCampaignCreator")
  crmWhatsAppMessages  CrmWhatsAppMessage[] @relation("CrmWhatsAppCreator")
  crmAutomations       CrmAutomation[]     @relation("CrmAutomationCreator")

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Geography ──────────────────────────────────────────────

model Country {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(3)
  name      String
  currency  Currency @default(COP)
  taxRate   Decimal  @default(0) @db.Decimal(5, 4)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availability ProductCountryAvailability[]
  priceRules   PriceRule[]
  priceTiers   PriceTier[]
}

// ── Catalog ────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([slug])
  @@index([parentId])
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  contactName String?
  email       String?
  phone       String?
  website     String?
  country     String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
}

model Product {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String?       @db.Text
  shortDesc       String?       @db.VarChar(500)
  sku             String        @unique
  status          ProductStatus @default(DRAFT)
  categoryId      String?
  supplierId      String?
  basePrice       Decimal       @db.Decimal(12, 2)
  baseCurrency    Currency      @default(USD)
  weight          Decimal?      @db.Decimal(8, 3)
  tags            String[]
  metaTitle       String?
  metaDescription String?       @db.VarChar(320)
  faqs            Json?
  restrictions    String?       @db.Text

  // ── Business Model Fields ──
  businessModel              BusinessModel @default(DROPSHIPPING)
  minimumOrderQuantity       Int           @default(1)
  minimumInvestment          Decimal?      @db.Decimal(12, 2)
  productionTimeDays         Int?
  isProgrammableDropshipping Boolean       @default(false)
  subscriptionAllowed        Boolean       @default(false)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category            Category?                    @relation(fields: [categoryId], references: [id])
  supplier            Supplier?                    @relation(fields: [supplierId], references: [id])
  variants            ProductVariant[]
  availability        ProductCountryAvailability[]
  assets              Asset[]
  priceRules          PriceRule[]
  research            ResearchNote[]
  collections         CollectionItem[]
  priceTiers          PriceTier[]
  orderItems          OrderItem[]
  platformReferences  PlatformProductReference[]

  @@index([slug])
  @@index([sku])
  @@index([status])
  @@index([categoryId])
  @@index([supplierId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  sku       String   @unique
  price     Decimal  @db.Decimal(12, 2)
  stock     Int      @default(0)
  attributes Json?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
}

model ProductCountryAvailability {
  id          String   @id @default(cuid())
  productId   String
  countryId   String
  available   Boolean  @default(true)
  localPrice  Decimal? @db.Decimal(12, 2)
  localCurrency Currency?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([productId, countryId])
  @@index([productId])
  @@index([countryId])
}

model PriceRule {
  id          String   @id @default(cuid())
  productId   String
  countryId   String?
  name        String
  type        String   @db.VarChar(20)
  value       Decimal  @db.Decimal(12, 2)
  minQty      Int?
  maxQty      Int?
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  country Country? @relation(fields: [countryId], references: [id])

  @@index([productId])
}

model Asset {
  id        String    @id @default(cuid())
  productId String?
  type      AssetType @default(IMAGE)
  url       String
  key       String
  filename  String
  mimeType  String?
  size      Int?
  alt       String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ── Research ───────────────────────────────────────────────

model ResearchNote {
  id        String   @id @default(cuid())
  productId String?
  title     String
  content   String   @db.Text
  source    String?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  benchmarks CompetitorBenchmark[]

  @@index([productId])
}

model CompetitorBenchmark {
  id             String   @id @default(cuid())
  researchNoteId String
  competitor     String
  url            String?
  price          Decimal? @db.Decimal(12, 2)
  currency       Currency @default(COP)
  rating         Decimal? @db.Decimal(3, 2)
  reviewCount    Int?
  pros           String[]
  cons           String[]
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  researchNote ResearchNote @relation(fields: [researchNoteId], references: [id], onDelete: Cascade)

  @@index([researchNoteId])
}

// ── Marketing ──────────────────────────────────────────────

model Playbook {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?        @db.Text
  status      PlaybookStatus @default(DRAFT)
  tags        String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sections PlaybookSection[]

  @@index([slug])
  @@index([status])
}

model PlaybookSection {
  id         String   @id @default(cuid())
  playbookId String
  phase      String   @db.VarChar(50)
  title      String
  content    String   @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  playbook Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId])
  @@index([phase])
}

model Template {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  type        TemplateType @default(EMAIL)
  subject     String?
  body        String       @db.Text
  variables   String[]
  tags        String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  campaigns   CrmEmailCampaign[]

  @@index([slug])
  @@index([type])
}

// ── Collections ────────────────────────────────────────────

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  productId    String
  notes        String?
  sortOrder    Int      @default(0)
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

// ── Audit ──────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model Event {
  id        String   @id @default(cuid())
  type      String
  payload   Json?
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([processed])
  @@index([createdAt])
}

// ── Price Tiers ───────────────────────────────────────────

model PriceTier {
  id              String   @id @default(cuid())
  productId       String
  countryId       String?
  minQuantity     Int
  maxQuantity     Int?
  costPrice       Decimal  @db.Decimal(12, 2)
  suggestedRetail Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  country Country? @relation(fields: [countryId], references: [id])

  @@index([productId])
  @@index([countryId])
}

// ── CRM / Orders ──────────────────────────────────────────

model Distributor {
  id           String   @id @default(cuid())
  userId       String
  companyName  String
  taxId        String?
  phone        String?
  address      String?
  city         String?
  country      String?
  notes        String?  @db.Text
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders             Order[]
  scheduledOrders    ScheduledOrder[]
  platformReferences PlatformProductReference[]
  crmContact         CrmContact?

  @@index([userId])
}

model Order {
  id             String      @id @default(cuid())
  distributorId  String
  orderNumber    String      @unique
  type           OrderType
  status         OrderStatus @default(PENDIENTE)
  subtotal       Decimal     @db.Decimal(12, 2)
  tax            Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  currency       Currency    @default(COP)
  notes          String?     @db.Text
  shippingAddress String?    @db.Text
  trackingNumber  String?
  estimatedDelivery DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  distributor    Distributor          @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  crmDeal        CrmDeal?

  @@index([distributorId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  variantInfo String? @db.VarChar(200)
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model ScheduledOrder {
  id             String   @id @default(cuid())
  distributorId  String
  productId      String?
  frequency      String   @db.VarChar(20) // weekly, biweekly, monthly
  quantity        Int
  nextDelivery   DateTime
  active         Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([distributorId])
  @@index([nextDelivery])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  notes     String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

// ── Platform Integrations ─────────────────────────────────

model PlatformProductReference {
  id                String   @id @default(cuid())
  productId         String
  distributorId     String?
  platformName      Platform
  platformProductId String
  platformVariantId String?
  syncEnabled       Boolean  @default(true)
  lastSyncAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  distributor Distributor? @relation(fields: [distributorId], references: [id])

  @@unique([productId, platformName, distributorId])
  @@index([productId])
  @@index([distributorId])
  @@index([platformName])
}

// ── CRM Models ───────────────────────────────────────────

model CrmContact {
  id            String           @id @default(cuid())
  type          CrmContactType   @default(PERSONA)
  source        CrmContactSource @default(MANUAL)

  firstName     String
  lastName      String?
  email         String?
  phone         String?
  whatsapp      String?
  companyName   String?
  position      String?
  website       String?
  address       String?
  city          String?
  country       String?

  tags          String[]
  customFields  Json?
  notes         String?          @db.Text

  distributorId String?          @unique
  assignedToId  String?
  createdById   String

  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  distributor       Distributor?        @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  assignedTo        User?               @relation("CrmContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy         User                @relation("CrmContactCreator", fields: [createdById], references: [id])
  leads             CrmLead[]
  deals             CrmDeal[]
  activities        CrmActivity[]
  emailRecipients   CrmEmailRecipient[]
  whatsappMessages  CrmWhatsAppMessage[]

  @@index([email])
  @@index([phone])
  @@index([distributorId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([source])
  @@index([active])
  @@index([createdAt])
}

model CrmPipeline {
  id          String          @id @default(cuid())
  name        String
  type        CrmPipelineType
  description String?
  isDefault   Boolean         @default(false)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  stages      CrmPipelineStage[]
  leads       CrmLead[]
  deals       CrmDeal[]
  automations CrmAutomation[]

  @@index([type])
  @@index([active])
}

model CrmPipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  name       String
  color      String   @default("#6B7280")
  sortOrder  Int      @default(0)
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pipeline   CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads      CrmLead[]
  deals      CrmDeal[]

  @@index([pipelineId, sortOrder])
  @@index([pipelineId])
}

model CrmLead {
  id            String           @id @default(cuid())
  title         String
  description   String?          @db.Text
  pipelineId    String
  stageId       String
  stageOrder    Int              @default(0)
  source        CrmContactSource @default(MANUAL)
  sourceDetail  String?
  contactId     String
  assignedToId  String?
  score         Int              @default(0)
  tags          String[]
  customFields  Json?
  convertedAt   DateTime?
  convertedDealId String?        @unique
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  pipeline      CrmPipeline      @relation(fields: [pipelineId], references: [id])
  stage         CrmPipelineStage @relation(fields: [stageId], references: [id])
  contact       CrmContact       @relation(fields: [contactId], references: [id])
  assignedTo    User?            @relation("CrmLeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedDeal CrmDeal?         @relation("LeadToDeal", fields: [convertedDealId], references: [id], onDelete: SetNull)
  activities    CrmActivity[]

  @@index([pipelineId, stageId, stageOrder])
  @@index([contactId])
  @@index([assignedToId])
  @@index([score])
  @@index([active])
  @@index([createdAt])
}

model CrmDeal {
  id                String   @id @default(cuid())
  title             String
  description       String?  @db.Text
  pipelineId        String
  stageId           String
  stageOrder        Int      @default(0)
  value             Decimal  @db.Decimal(12, 2)
  currency          Currency @default(COP)
  probability       Int      @default(50)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  contactId         String
  orderId           String?  @unique
  assignedToId      String?
  tags              String[]
  customFields      Json?
  lostReason        String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pipeline   CrmPipeline      @relation(fields: [pipelineId], references: [id])
  stage      CrmPipelineStage @relation(fields: [stageId], references: [id])
  contact    CrmContact       @relation(fields: [contactId], references: [id])
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedTo User?            @relation("CrmDealAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  fromLead   CrmLead?         @relation("LeadToDeal")
  activities CrmActivity[]

  @@index([pipelineId, stageId, stageOrder])
  @@index([contactId])
  @@index([assignedToId])
  @@index([orderId])
  @@index([active])
  @@index([closedAt])
  @@index([expectedCloseDate])
  @@index([createdAt])
}

model CrmActivity {
  id          String          @id @default(cuid())
  type        CrmActivityType
  subject     String
  body        String?         @db.Text
  contactId   String?
  leadId      String?
  dealId      String?
  scheduledAt DateTime?
  completedAt DateTime?
  createdById String
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  contact   CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead      CrmLead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal      CrmDeal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdBy User        @relation("CrmActivityCreator", fields: [createdById], references: [id])

  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
  @@index([type])
  @@index([createdAt])
  @@index([scheduledAt])
}

model CrmEmailCampaign {
  id              String            @id @default(cuid())
  name            String
  subject         String
  body            String            @db.Text
  templateId      String?
  fromName        String?
  replyTo         String?
  status          CrmCampaignStatus @default(BORRADOR)
  scheduledAt     DateTime?
  sentAt          DateTime?
  totalRecipients Int               @default(0)
  totalSent       Int               @default(0)
  totalDelivered  Int               @default(0)
  totalOpened     Int               @default(0)
  totalClicked    Int               @default(0)
  totalBounced    Int               @default(0)
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  template   Template?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy  User               @relation("CrmCampaignCreator", fields: [createdById], references: [id])
  recipients CrmEmailRecipient[]

  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model CrmEmailRecipient {
  id          String         @id @default(cuid())
  campaignId  String
  contactId   String?
  email       String
  name        String?
  status      CrmEmailStatus @default(PENDIENTE)
  resendId    String?
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  bouncedAt   DateTime?
  metadata    Json?
  createdAt   DateTime       @default(now())

  campaign CrmEmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  CrmContact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([contactId])
  @@index([resendId])
}

model CrmWhatsAppMessage {
  id              String               @id @default(cuid())
  contactId       String
  direction       CrmWhatsAppDirection
  status          CrmWhatsAppStatus    @default(PENDIENTE)
  templateName    String?
  templateParams  Json?
  body            String?              @db.Text
  mediaUrl        String?
  waMessageId     String?              @unique
  waPhoneNumberId String?
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  failedReason    String?
  createdById     String?
  createdAt       DateTime             @default(now())

  contact   CrmContact @relation(fields: [contactId], references: [id])
  createdBy User?      @relation("CrmWhatsAppCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([contactId])
  @@index([waMessageId])
  @@index([status])
  @@index([createdAt])
}

model CrmAutomation {
  id             String               @id @default(cuid())
  name           String
  description    String?
  trigger        CrmAutomationTrigger
  triggerConfig  Json?
  action         CrmAutomationAction
  actionConfig   Json?
  pipelineId     String?
  active         Boolean              @default(true)
  executionCount Int                  @default(0)
  lastExecutedAt DateTime?
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  pipeline  CrmPipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  createdBy User         @relation("CrmAutomationCreator", fields: [createdById], references: [id])

  @@index([trigger])
  @@index([active])
  @@index([pipelineId])
}
