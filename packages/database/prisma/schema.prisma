generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  ANALYST
  DROPSHIPPER
  GUEST
}

enum Currency {
  COP
  USD
}

enum AssetType {
  IMAGE
  VIDEO
  DOCUMENT
  CERTIFICATE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  PAUSED
  DISCONTINUED
}

enum PlaybookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TemplateType {
  EMAIL
  SOCIAL
  LANDING
  AD
  WHATSAPP
}

// ── Auth Models ────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          Role      @default(GUEST)
  image         String?
  emailVerified DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  collections Collection[]
  auditLogs   AuditLog[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Geography ──────────────────────────────────────────────

model Country {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(3)
  name      String
  currency  Currency @default(COP)
  taxRate   Decimal  @default(0) @db.Decimal(5, 4)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availability ProductCountryAvailability[]
  priceRules   PriceRule[]
}

// ── Catalog ────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([slug])
  @@index([parentId])
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  contactName String?
  email       String?
  phone       String?
  website     String?
  country     String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
}

model Product {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String?       @db.Text
  shortDesc       String?       @db.VarChar(500)
  sku             String        @unique
  status          ProductStatus @default(DRAFT)
  categoryId      String?
  supplierId      String?
  basePrice       Decimal       @db.Decimal(12, 2)
  baseCurrency    Currency      @default(USD)
  weight          Decimal?      @db.Decimal(8, 3)
  tags            String[]
  metaTitle       String?
  metaDescription String?       @db.VarChar(320)
  faqs            Json?
  restrictions    String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category     Category?                    @relation(fields: [categoryId], references: [id])
  supplier     Supplier?                    @relation(fields: [supplierId], references: [id])
  variants     ProductVariant[]
  availability ProductCountryAvailability[]
  assets       Asset[]
  priceRules   PriceRule[]
  research     ResearchNote[]
  collections  CollectionItem[]

  @@index([slug])
  @@index([sku])
  @@index([status])
  @@index([categoryId])
  @@index([supplierId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  sku       String   @unique
  price     Decimal  @db.Decimal(12, 2)
  stock     Int      @default(0)
  attributes Json?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
}

model ProductCountryAvailability {
  id          String   @id @default(cuid())
  productId   String
  countryId   String
  available   Boolean  @default(true)
  localPrice  Decimal? @db.Decimal(12, 2)
  localCurrency Currency?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([productId, countryId])
  @@index([productId])
  @@index([countryId])
}

model PriceRule {
  id          String   @id @default(cuid())
  productId   String
  countryId   String?
  name        String
  type        String   @db.VarChar(20)
  value       Decimal  @db.Decimal(12, 2)
  minQty      Int?
  maxQty      Int?
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  country Country? @relation(fields: [countryId], references: [id])

  @@index([productId])
}

model Asset {
  id        String    @id @default(cuid())
  productId String?
  type      AssetType @default(IMAGE)
  url       String
  key       String
  filename  String
  mimeType  String?
  size      Int?
  alt       String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ── Research ───────────────────────────────────────────────

model ResearchNote {
  id        String   @id @default(cuid())
  productId String?
  title     String
  content   String   @db.Text
  source    String?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  benchmarks CompetitorBenchmark[]

  @@index([productId])
}

model CompetitorBenchmark {
  id             String   @id @default(cuid())
  researchNoteId String
  competitor     String
  url            String?
  price          Decimal? @db.Decimal(12, 2)
  currency       Currency @default(COP)
  rating         Decimal? @db.Decimal(3, 2)
  reviewCount    Int?
  pros           String[]
  cons           String[]
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  researchNote ResearchNote @relation(fields: [researchNoteId], references: [id], onDelete: Cascade)

  @@index([researchNoteId])
}

// ── Marketing ──────────────────────────────────────────────

model Playbook {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?        @db.Text
  status      PlaybookStatus @default(DRAFT)
  tags        String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sections PlaybookSection[]

  @@index([slug])
  @@index([status])
}

model PlaybookSection {
  id         String   @id @default(cuid())
  playbookId String
  phase      String   @db.VarChar(50)
  title      String
  content    String   @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  playbook Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId])
  @@index([phase])
}

model Template {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  type        TemplateType @default(EMAIL)
  subject     String?
  body        String       @db.Text
  variables   String[]
  tags        String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([slug])
  @@index([type])
}

// ── Collections ────────────────────────────────────────────

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  productId    String
  notes        String?
  sortOrder    Int      @default(0)
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

// ── Audit ──────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model Event {
  id        String   @id @default(cuid())
  type      String
  payload   Json?
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([processed])
  @@index([createdAt])
}
